    },
    "died": {
      "date-burried": "1 Feb churchyard of St Lawrence"
    },
    "original-info": "Waterfoot-Lenches, Rossendale, Haslingden, Lancashire, & ironmonger, & Mary Wilson formerly Taylor; 2 Aug 1886, 2nd form prize, The Grammar School, Newchurch (founded 1701); 19 Mar 1889, confirmed St James' Waterfoot; 1893 Easter matriculated Cambridge University from Ayerst Hall; 1894 migrated to St Catharine's College; BA 1896; 27 Sept 1896 ordained deacon in York Minster by Archbishop William Dalrymple Maclagan, curate Christ Church, Hull, Yorkshire; 19 Dec 1897 ordained priest in York Minster by Archbishop William Dalrymple Maclagan; 8 Feb 1899, curate St Andrew's, Drypool, Hull; 23 Oct 1899, curate Christ Church, Blackpool; 28 May 1900, curate St Jude's, Mildmay Park, London; 18 Mar 1901, missionary chaplain during construction of extension of Keyham Naval Docks near Devonport; 11 July 1903, curate Christ Church, Leicester; 14 Oct 1904, Vicar of Christ Church, Leicester; 1909 author 'A Sketch of the History of Christ Church Leicester'; 18 Jan 1911 Vicar of Christ Church, Chadderton, Lancashire; 19 Nov 1917, Vicar of All Saints, Hamer, Lancashire; 19 Dec 1924, Vicar of St John the Evangelist, Carlisle; 13 Mar 1931, Vicar of All Saints, Upper Holloway, London; 31 May 1937 Rector of Bidborough, Kent; retired 1946; bd 1 Feb churchyard of St Lawrence, Bidborough",
    "sources": [
      {
        "source": "census 1881 8, scholar, B Lancashire, Waterfoot"
      },
      {
        "source": "census 1891 31 Bacup Rd, Newchurch, 18, pupil teacher"
      }
    ],
    "todo": "death: missing death date",
    "remaining-info": "Waterfoot-Lenches, Rossendale, Haslingden, Lancashire, & ironmonger, & Mary Wilson formerly Taylor; 2 Aug 1886, 2nd form prize, The Grammar School, Newchurch (founded 1701); 19 Mar 1889, confirmed St James' Waterfoot; 1893 Easter matriculated Cambridge University from Ayerst Hall; 1894 migrated to St Catharine's College; BA 1896; 27 Sept 1896 ordained deacon in York Minster by Archbishop William Dalrymple Maclagan, curate Christ Church, Hull, Yorkshire; 19 Dec 1897 ordained priest in York Minster by Archbishop William Dalrymple Maclagan; 8 Feb 1899, curate St Andrew's, Drypool, Hull; 23 Oct 1899, curate Christ Church, Blackpool; 28 May 1900, curate St Jude's, Mildmay Park, London; 18 Mar 1901, missionary chaplain during construction of extension of Keyham Naval Docks near Devonport; 11 July 1903, curate Christ Church, Leicester; 14 Oct 1904, Vicar of Christ Church, Leicester; 1909 author 'A Sketch of the History of Christ Church Leicester'; 18 Jan 1911 Vicar of Christ Church, Chadderton, Lancashire; 19 Nov 1917, Vicar of All Saints, Hamer, Lancashire; 19 Dec 1924, Vicar of St John the Evangelist, Carlisle; 13 Mar 1931, Vicar of All Saints, Upper Holloway, London; 31 May 1937 Rector of Bidborough, Kent; retired 1946"
  },
