{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Family Branch Person",
  "description": "Schema for a single person in a family branch JSON file",
  "type": "object",
  "required": ["id", "name", "birthday"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique person ID",
      "examples": ["1800_grandfather_gf", "1852_mother_m1"]
    },
    "name": {
      "type": "string",
      "description": "Full display name in original text case",
      "examples": ["John Smith", "Mary Jones"]
    },
    "name-parts": {
      "type": "object",
      "description": "Parsed name components",
      "properties": {
        "firstname": {
          "type": "string",
          "description": "First name in original case",
          "examples": ["John", "Mary"]
        },
        "middle-name": {
          "type": "string",
          "description": "Middle name(s) in original case, empty string if none",
          "examples": ["", "James", "Ann Elizabeth"]
        },
        "surname": {
          "type": "string",
          "description": "Surname in original case. For females with maiden name, this is the maiden name",
          "examples": ["Smith", "Jones"]
        },
        "maiden_name": {
          "type": "string",
          "description": "Maiden name for females, empty string if not applicable",
          "examples": ["", "Jones", "Smith"]
        }
      }
    },
    "full-name": {
      "type": "string",
      "description": "Full name including maiden name in parentheses if applicable, in original text case",
      "examples": ["John Smith", "Mary Jones (Jones)"]
    },
    "birthday": {
      "type": "string",
      "description": "Birth date in ISO format YYYY-MM-DD or YYYY if exact date unknown",
      "examples": ["1800-01-15", "1852"]
    },
    "birthplace": {
      "type": "string",
      "description": "Birth place",
      "examples": ["London, England"]
    },
    "gender": {
      "type": "string",
      "enum": ["M", "F", "U"],
      "description": "M=male, F=female, U=unknown"
    },
    "died": {
      "type": "object",
      "description": "Death details",
      "properties": {
        "date": {
          "type": "string",
          "description": "Death date in ISO format",
          "examples": ["1875-03-10"]
        },
        "place": {
          "type": "string",
          "description": "Death place",
          "examples": ["London, England"]
        },
        "burial": {
          "type": "string",
          "description": "Burial place or note",
          "examples": ["Abney Park", "Bunhill"]
        }
      }
    },
    "occupation": {
      "type": "string",
      "description": "Occupation or profession",
      "examples": ["Farmer", "Merchant"]
    },
    "spouses": {
      "type": "array",
      "description": "Spouses in marriage order",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference to spouse person ID"
          },
          "marriedYear": {
            "type": "string",
            "description": "Year of marriage",
            "examples": ["1825"]
          },
          "marriedDate": {
            "type": "string",
            "description": "Exact marriage date in ISO format",
            "examples": ["1825-06-12"]
          },
          "marriedPlace": {
            "type": "string",
            "description": "Place of marriage",
            "examples": ["London, England"]
          }
        }
      }
    },
    "children": {
      "type": "array",
      "description": "Biological children",
      "items": {
        "type": "string",
        "description": "Reference to child person ID"
      }
    },
    "parents": {
      "type": "object",
      "description": "Biological parents",
      "properties": {
        "father": {
          "type": "string",
          "description": "Reference to father person ID"
        },
        "mother": {
          "type": "string",
          "description": "Reference to mother person ID"
        }
      }
    },
    "info": {
      "type": "string",
      "description": "Any additional structured notes or biographical info that could not be extracted into structured fields"
    },
    "original_info": {
      "type": "string",
      "description": "The very original info text before any extraction or cleaning"
    },
    "marriage": {
      "type": "string",
      "description": "Marriage date extracted from info text",
      "examples": ["21 May 1840", "Q2 1860"]
    },
    "marriageplace": {
      "type": "string",
      "description": "Place of marriage extracted from info text, if different from birthplace or deathplace",
      "examples": ["London, England"]
    },
    "sources": {
      "type": "array",
      "description": "Source references and extracted evidence such as baptism and census records",
      "items": {
        "type": "string",
        "examples": ["(WHS)", "(MEHS)", "census 1841", "baptism 25 Oct 1801"]
      }
    },
    "crossBranch": {
      "type": "array",
      "description": "Links to persons in other branch files",
      "items": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string",
            "description": "Branch file name without extension",
            "examples": ["soul", "wilson", "coles"]
          },
          "id": {
            "type": "string",
            "description": "Person ID in that branch"
          },
          "relationship": {
            "type": "string",
            "description": "Relationship description",
            "examples": ["married into", "descendant of"]
          }
        }
      }
    }
  }
}
